# Server
PORT=3000
NODE_ENV=production
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=12h

# First-run staff accounts (seeded only when the database is empty)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=MSSN2026!
SCOREKEEPER_USERNAME=scorekeeper
SCOREKEEPER_PASSWORD=SCORE2026!

# Optional: require /display?key=YOUR_KEY for the projector
DISPLAY_KEY=

# SQLite location (mount this directory as a persistent disk in production)
DB_PATH=./data/quiz.db
